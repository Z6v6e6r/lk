        <mxCell id="title" value="Partner Game Membership API v0.2 — production gates" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=30;fontStyle=1;fontColor=#172033;" vertex="1" parent="1">
