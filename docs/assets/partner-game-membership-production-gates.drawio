        <mxCell id="source" value="Exact pushed SHA&#xa;+ green exact-head CI&#xa;+ clean isolated worktree at exact commit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6D9EEB;fontSize=15;fontStyle=1;fontColor=#223047;" vertex="1" parent="evidence-zone">
