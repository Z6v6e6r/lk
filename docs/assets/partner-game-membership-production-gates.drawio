          <mxGeometry x="40" y="455" width="250" height="82" as="geometry"/>
        </mxCell>

        <mxCell id="ingress" value="Ingress binding — UNBOUND&#xa;exact Host/SNI + 3 routes only&#xa;mandatory mTLS + signed audience" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8E70C1;fontSize=14;fontStyle=1;fontColor=#35264F;" vertex="1" parent="binding-zone">
          <mxGeometry x="40" y="70" width="250" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="ingress-policy" value="No shared/direct Node-RED path&#xa;strip inbound Forwarded • no CORS/retry&#xa;duplicate headers + JSON keys reject" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9DDFF;strokeColor=#8E70C1;fontSize=14;fontColor=#35264F;" vertex="1" parent="binding-zone">
          <mxGeometry x="40" y="195" width="250" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="custody" value="Packet custody — UNBOUND&#xa;SECRET_BEARING • partner transfer OFF&#xa;0700 / 0600 • named owners" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8E70C1;fontSize=14;fontStyle=1;fontColor=#35264F;" vertex="1" parent="binding-zone">
          <mxGeometry x="40" y="325" width="250" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="provider" value="Viva + Mongo contracts&#xa;idempotency • ON_PLACE • exact read-back&#xa;replica/index/rollback/reconciliation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8E70C1;fontSize=13;fontColor=#35264F;" vertex="1" parent="binding-zone">
          <mxGeometry x="40" y="455" width="250" height="82" as="geometry"/>
        </mxCell>

