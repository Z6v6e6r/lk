        <mxCell id="legend" value="Ключевой invariant: право удалить даёт только canonical membership ownership, а не имя, телефон, source в roster или Viva booking ID из request." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#172033;strokeColor=#172033;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="935" width="1520" height="42" as="geometry"/>
        </mxCell>
