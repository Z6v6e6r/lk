  <diagram id="partner-security" name="Security architecture">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Partner Game Membership API — защита запроса и владения" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=30;fontStyle=1;fontColor=#172033;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1120" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="status" value="v0.2 deployable pilot • default-off • LIVE gates UNBOUND" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE8E7;strokeColor=#C94A45;fontColor=#7A2521;fontSize=15;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="1190" y="35" width="370" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Перехваченный request нельзя изменить или повторить: HMAC связывает method/path/body/time/nonce/idempotency, а nonce атомарно расходуется до любой бизнес-операции." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontColor=#45516A;" vertex="1" parent="1">
          <mxGeometry x="40" y="85" width="1520" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="partner-zone" value="1  ВНЕШНИЙ ПАРТНЁР" style="swimlane;html=1;rounded=1;startSize=42;horizontal=1;fillColor=#EAF3FF;strokeColor=#6D9EEB;fontColor=#244B76;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="280" height="650" as="geometry"/>
        </mxCell>
        <mxCell id="api-zone" value="2  PADLHUB SECURITY BOUNDARY" style="swimlane;html=1;rounded=1;startSize=42;horizontal=1;fillColor=#F2ECFF;strokeColor=#8E70C1;fontColor=#4B3673;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="150" width="440" height="650" as="geometry"/>
        </mxCell>
        <mxCell id="mongo-zone" value="3  MONGO: DURABLE FENCES" style="swimlane;html=1;rounded=1;startSize=42;horizontal=1;fillColor=#EAF8F0;strokeColor=#5BAA76;fontColor=#235E39;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="150" width="320" height="650" as="geometry"/>
        </mxCell>
        <mxCell id="viva-zone" value="4  VIVA / PROVIDER" style="swimlane;html=1;rounded=1;startSize=42;horizontal=1;fillColor=#FFF7E3;strokeColor=#D6A23A;fontColor=#78591A;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1170" y="150" width="390" height="650" as="geometry"/>
        </mxCell>

        <mxCell id="client" value="API client&#xa;clientId + keyId + exact audience" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6D9EEB;fontSize=16;fontStyle=1;fontColor=#223047;" vertex="1" parent="partner-zone">
          <mxGeometry x="35" y="80" width="210" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="kms" value="KMS / secret manager&#xa;HMAC key ≥ 32 bytes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6D9EEB;fontSize=14;fontColor=#223047;" vertex="1" parent="partner-zone">
          <mxGeometry x="35" y="190" width="210" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="clock" value="NTP + CSPRNG&#xa;timestamp ±90s • nonce 192+ bit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6D9EEB;fontSize=14;fontColor=#223047;" vertex="1" parent="partner-zone">
          <mxGeometry x="35" y="298" width="210" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="retry" value="Легальный retry&#xa;новый nonce / correlation / HMAC&#xa;тот же idempotency + body" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEBFF;strokeColor=#6D9EEB;fontSize=14;fontColor=#223047;" vertex="1" parent="partner-zone">
          <mxGeometry x="35" y="435" width="210" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="no-secret" value="Секрет и signature&#xa;не попадают в body/logs" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFF4CF;strokeColor=#D6A23A;fontSize=13;fontColor=#624B1B;" vertex="1" parent="partner-zone">
          <mxGeometry x="45" y="560" width="190" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="ingress" value="Ingress gate — UNBOUND&#xa;mandatory mTLS + exact Host/SNI&#xa;socket peer • TLS • rate/body limit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8E70C1;fontSize=14;fontStyle=1;fontColor=#35264F;" vertex="1" parent="api-zone">
          <mxGeometry x="45" y="55" width="350" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="verify" value="A. Проверка proof v2&#xa;exact audience + method + path + canonical body&#xa;timestamp + constant-time HMAC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8E70C1;fontSize=14;fontColor=#35264F;" vertex="1" parent="api-zone">
          <mxGeometry x="45" y="165" width="350" height="82" as="geometry"/>
        </mxCell>
        <mxCell id="nonce" value="B. До mutation&#xa;atomic consume nonce → durable ingress audit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9DDFF;strokeColor=#8E70C1;fontSize=14;fontStyle=1;fontColor=#35264F;" vertex="1" parent="api-zone">
          <mxGeometry x="45" y="280" width="350" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="acl" value="C. Scope + readiness ДО operation&#xa;Viva contract + token + mutation gates&#xa;затем station/open game" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8E70C1;fontSize=14;fontColor=#35264F;" vertex="1" parent="api-zone">
          <mxGeometry x="45" y="385" width="350" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="owned" value="D. Ownership gate&#xa;exact membershipId + clientId + gameId&#xa;+ ACTIVE + stored station still allowed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9DDFF;strokeColor=#8E70C1;fontSize=14;fontStyle=1;fontColor=#35264F;" vertex="1" parent="api-zone">
          <mxGeometry x="45" y="510" width="350" height="85" as="geometry"/>
        </mxCell>

        <mxCell id="nonce-ledger" value="anti-replay ledger&#xa;unique nonce ID + TTL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5BAA76;fontSize=14;fontColor=#234E34;" vertex="1" parent="mongo-zone">
          <mxGeometry x="40" y="65" width="240" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="op-ledger" value="operation ledger&#xa;unique (client, idempotency)&#xa;RECEIVED → COMPLETED / UNKNOWN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5BAA76;fontSize=14;fontColor=#234E34;" vertex="1" parent="mongo-zone">
          <mxGeometry x="40" y="175" width="240" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="member-ledger" value="membership authority&#xa;owner + generation + exact Viva binding&#xa;unique activeKey" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3E5;strokeColor=#5BAA76;fontSize=14;fontStyle=1;fontColor=#234E34;" vertex="1" parent="mongo-zone">
          <mxGeometry x="40" y="305" width="240" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="game-ledger" value="lk_games projection&#xa;participant source=PARTNER_API&#xa;payment PAID / EXTERNAL_PARTNER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5BAA76;fontSize=14;fontColor=#234E34;" vertex="1" parent="mongo-zone">
          <mxGeometry x="40" y="435" width="240" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="audit-ledger" value="transactional audit + outbox&#xa;HMAC fingerprints • no raw PII/secrets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3E5;strokeColor=#5BAA76;fontSize=14;fontStyle=1;fontColor=#234E34;" vertex="1" parent="mongo-zone">
          <mxGeometry x="40" y="560" width="240" height="58" as="geometry"/>
        </mxCell>

        <mxCell id="disabled" value="REAL VIVA ADAPTER&#xa;4 fail-closed gates • default OFF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE8E7;strokeColor=#C94A45;fontSize=16;fontStyle=1;fontColor=#7A2521;" vertex="1" parent="viva-zone">
          <mxGeometry x="50" y="65" width="290" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="synthetic" value="Provider readiness&#xa;approved revision • idempotency&#xa;ON_PLACE • service token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6A23A;fontSize=14;fontColor=#624B1B;" vertex="1" parent="viva-zone">
          <mxGeometry x="50" y="180" width="290" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="technical" value="Viva technical booking&#xa;POST booking → ON_PLACE&#xa;GET probe → PUT cancel-only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1C9;strokeColor=#D6A23A;fontSize=14;fontStyle=1;fontColor=#624B1B;" vertex="1" parent="viva-zone">
          <mxGeometry x="50" y="320" width="290" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="readback" value="Обязательный exact read-back&#xa;exerciseId + bookingId + technicalClientId&#xa;нет совпадения → UNKNOWN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6A23A;fontSize=14;fontColor=#624B1B;" vertex="1" parent="viva-zone">
          <mxGeometry x="50" y="470" width="290" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="no-blind" value="No retry • redirect=error • 5xx/timeout → UNKNOWN" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FDE8E7;strokeColor=#C94A45;fontSize=13;fontStyle=1;fontColor=#7A2521;" vertex="1" parent="viva-zone">
          <mxGeometry x="70" y="585" width="250" height="45" as="geometry"/>
        </mxCell>

        <mxCell id="edge-request" value="TLS + signed request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#405A88;fontSize=13;fontStyle=1;endArrow=block;endFill=1;" edge="1" parent="1" source="client" target="ingress">
