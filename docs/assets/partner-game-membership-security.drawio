        <mxCell id="edge-kms" value="HMAC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6D9EEB;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="kms" target="client">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge-clock" value="fresh proof" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6D9EEB;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="clock" target="client">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge-ingress-verify" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#7153A4;endArrow=block;endFill=1;" edge="1" parent="1" source="ingress" target="verify"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge-verify-nonce" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#7153A4;endArrow=block;endFill=1;" edge="1" parent="1" source="verify" target="nonce"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge-nonce-acl" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#7153A4;endArrow=block;endFill=1;" edge="1" parent="1" source="nonce" target="acl"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge-acl-owned" value="DELETE only" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#7153A4;endArrow=block;endFill=1;" edge="1" parent="1" source="acl" target="owned"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge-nonce-ledger" value="majority insert" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#3F8A59;endArrow=block;endFill=1;" edge="1" parent="1" source="nonce" target="nonce-ledger"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge-acl-op" value="idempotent operation" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#3F8A59;endArrow=block;endFill=1;" edge="1" parent="1" source="acl" target="op-ledger"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge-owned-member" value="exact owner row" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#3F8A59;endArrow=block;endFill=1;" edge="1" parent="1" source="owned" target="member-ledger"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge-member-provider" value="server binding" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#B17A12;endArrow=block;endFill=1;" edge="1" parent="1" source="member-ledger" target="technical"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge-provider-readback" value="provider ACK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#B17A12;endArrow=block;endFill=1;" edge="1" parent="1" source="technical" target="readback"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge-readback-game" value="exact match → transaction" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#3F8A59;endArrow=block;endFill=1;" edge="1" parent="1" source="readback" target="game-ledger"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge-game-audit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#3F8A59;endArrow=block;endFill=1;" edge="1" parent="1" source="game-ledger" target="audit-ledger"><mxGeometry relative="1" as="geometry"/></mxCell>
