        <mxCell id="reject" value="REJECT ДО VIVA&#xa;401 proof • 403 scope/station/ownership&#xa;409 replay/idempotency/game state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE8E7;strokeColor=#C94A45;fontSize=14;fontStyle=1;fontColor=#7A2521;" vertex="1" parent="1">
          <mxGeometry x="410" y="835" width="690" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="edge-reject" value="fail closed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#C94A45;dashed=1;endArrow=block;endFill=1;" edge="1" parent="1" source="verify" target="reject"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="unknown" value="UNKNOWN ПОСЛЕ НЕОДНОЗНАЧНОГО ACK&#xa;202 + operationId • reconciliation по exact binding • без автоматического повтора" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1C9;strokeColor=#D6A23A;fontSize=14;fontStyle=1;fontColor=#624B1B;" vertex="1" parent="1">
          <mxGeometry x="1160" y="835" width="400" height="75" as="geometry"/>
        </mxCell>
