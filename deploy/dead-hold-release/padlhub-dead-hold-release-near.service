[Unit]
Description=Release subscription holds whose Viva booking is cancelled (near window)
Documentation=file:/root/.node-red/dead-hold-release/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
ExecStart=/root/.node-red/dead-hold-release/run-dead-hold-release.sh near
TimeoutStartSec=1500
