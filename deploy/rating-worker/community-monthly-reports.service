[Unit]
Description=PadlHub public monthly reports (no tournament closure)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=30min
StartLimitBurst=3

[Service]
Type=oneshot
ExecStart=/opt/padlhub-community-monthly/current/deploy/rating-worker/run-monthly-reports.sh
TimeoutStartSec=30min
Restart=on-failure
RestartSec=60s
UMask=0077
