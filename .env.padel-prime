# Падел Прайм (тенант Dvjlor) — тестовая сборка на техническом хосте.
# Домен клуба не используется: всё живёт на lk-reserve-89 (sslip.io).
VITE_TENANT_KEY=Dvjlor
VITE_API_BASE=https://api.vivacrm.ru
VITE_KEYCLOAK_BASE=https://kc.vivacrm.ru

# Игровой/сообщественный контур клона (Node-RED -> /pade-prime/*). До применения
# бэкенда эти пути отвечают 404 — это ожидаемое состояние тестовой версии.
VITE_SERV2=https://lk-reserve.89-108-64-209.sslip.io/pade-prime
