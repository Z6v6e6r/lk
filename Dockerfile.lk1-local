FROM node:22-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5
WORKDIR /workspace
COPY package.json package-lock.json ./
# The existing lock omits Linux Rollup binaries (the CI installs its x64 peer).
# Install only the arm64 peer at the same pinned Rollup version for this Mac.
RUN npm ci --include=optional --no-audit --no-fund \
    && npm install --prefix /tmp/lk1-rollup-native --no-save --no-package-lock --ignore-scripts --no-audit --no-fund @rollup/rollup-linux-arm64-gnu@4.57.0 \
    && cp -R /tmp/lk1-rollup-native/node_modules/@rollup/rollup-linux-arm64-gnu node_modules/@rollup/ \
    && rm -rf /tmp/lk1-rollup-native \
    && node -e "if(require('rollup/package.json').version!==require('@rollup/rollup-linux-arm64-gnu/package.json').version)process.exit(1)" \
    && npm cache clean --force
USER node
CMD ["node_modules/.bin/vite", "--config", "vite.config.lk1-local.mjs"]
