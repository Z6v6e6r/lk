{
  "name": "cabinet",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:prod && npm run build:dev:bundles",
    "build:prod": "tsc -b && vite build && vite build --config vite.config.games.ts && vite build --config vite.config.tournaments.ts && vite build --config vite.config.tournament-signup.ts && vite build --config vite.config.group-schedule.ts && vite build --config vite.config.padel-day-schedule.ts && vite build --config vite.config.tournament-subscription.ts && vite build --config vite.config.tournament-subscription-referral.ts && vite build --config vite.config.onboarding.ts && vite build --config vite.config.levels-info.ts && vite build --config vite.config.communities.ts && vite build --config vite.config.academy.ts && node scripts/write-release.mjs dist release.json && node scripts/write-release.mjs dist release-ffc-academy.json",
    "build:dev": "tsc -b && npm run build:dev:bundles",
    "build:dev:bundles": "vite build --mode dev && vite build --config vite.config.games.ts --mode dev && vite build --config vite.config.tournaments.ts --mode dev && vite build --config vite.config.tournament-signup.ts --mode dev && vite build --config vite.config.group-schedule.ts --mode dev && vite build --config vite.config.padel-day-schedule.ts --mode dev && vite build --config vite.config.tournament-subscription.ts --mode dev && vite build --config vite.config.tournament-subscription-referral.ts --mode dev && vite build --config vite.config.onboarding.ts --mode dev && vite build --config vite.config.levels-info.ts --mode dev && vite build --config vite.config.communities.ts --mode dev && node scripts/write-release.mjs dist release-dev.json && vite build --config vite.config.academy.ts --mode dev && node scripts/write-release.mjs dist release-ffc-academy-dev.json",
    "build:academy": "tsc -b && vite build --config vite.config.academy.ts && node scripts/write-release.mjs dist release-ffc-academy.json",
    "build:academy:dev": "tsc -b && vite build --config vite.config.academy.ts --mode dev && node scripts/write-release.mjs dist release-ffc-academy-dev.json",
    "build:academy:all": "npm run build:academy && npm run build:academy:dev",
    "deploy:prod": "bash ./scripts/deploy-lk-topology.sh prod",
    "deploy:dev": "bash ./scripts/deploy-lk-topology.sh dev",
    "deploy:all": "bash ./scripts/deploy-lk-topology.sh all",
    "deploy:split:prod": "bash ./scripts/deploy-lk-topology.sh prod",
    "deploy:split:dev": "bash ./scripts/deploy-lk-topology.sh dev",
    "deploy:split:all": "bash ./scripts/deploy-lk-topology.sh all",
    "deploy:mirror:prod": "DEPLOY_TARGETS='lk-reserve-89:/var/www/html/lk,lk-primary-147:/var/www/html/lk' bash ./scripts/deploy-lk.sh prod",
    "deploy:mirror:dev": "DEPLOY_TARGETS='lk-reserve-89:/var/www/html/lk,lk-primary-147:/var/www/html/lk' bash ./scripts/deploy-lk.sh dev",
    "deploy:mirror:all": "DEPLOY_TARGETS='lk-reserve-89:/var/www/html/lk,lk-primary-147:/var/www/html/lk' bash ./scripts/deploy-lk.sh all",
    "package:upload:prod": "bash ./scripts/package-lk-upload.sh prod",
    "package:upload:dev": "bash ./scripts/package-lk-upload.sh dev",
    "package:upload:all": "bash ./scripts/package-lk-upload.sh all",
    "release:preflight": "node scripts/assert-clean-deploy.mjs dist/release.json dist/release-dev.json",
    "release:preflight:prod": "node scripts/assert-clean-deploy.mjs dist/release.json",
    "release:preflight:dev": "node scripts/assert-clean-deploy.mjs dist/release-dev.json",
    "audit:release-artifacts": "node scripts/audit_release_artifacts.mjs",
    "audit:nodered-flow-drift": "node scripts/audit_nodered_flow_drift.mjs",
    "cap:sync:android": "node scripts/write-capacitor-index.mjs && npx cap sync android",
    "cap:sync:ios": "node scripts/write-capacitor-index.mjs && npx cap sync ios",
    "android:apk:debug": "npm run build:prod && npm run cap:sync:android && cd android && ./gradlew assembleDebug",
    "ios:build:debug": "npm run build:prod && npm run cap:sync:ios && cd ios/App && xcodebuild -project App.xcodeproj -scheme App -configuration Debug -sdk iphonesimulator build",
    "ios:archive": "npm run build:prod && npm run cap:sync:ios && cd ios/App && xcodebuild -project App.xcodeproj -scheme App -configuration Release -archivePath build/App.xcarchive -destination 'generic/platform=iOS' archive",
    "ios:open": "npx cap open ios",
    "fcm:send": "node ./scripts/fcm/send-fcm.mjs",
    "build:analyze": "ANALYZE=1 vite build",
    "repair:split-timeout": "node scripts/repair_split_timeout_false_positives.mjs",
    "repair:hide-cancelled-games": "node scripts/hide_cancelled_viva_games.mjs",
    "repair:result-launch-period": "node scripts/repair_result_launch_period.mjs",
    "repair:result-roster": "node scripts/repair_result_roster_snapshots.mjs",
    "subscriptions:report": "node scripts/report_ab_leto_subscriptions.mjs",
    "subscriptions:reconcile-viva": "node scripts/reconcile_ab_leto_viva_sales.mjs",
    "subscriptions:reset-limits": "node scripts/reset_ab_leto_limits.mjs",
    "visits:sync-viva": "node scripts/sync_training_visits_from_viva.mjs",
    "nodered:modular:pull-147": "bash ./scripts/pull_nodered_source_from_147.sh",
    "nodered:modular:verify": "node scripts/verify_nodered_source_origin.mjs",
    "nodered:modular:audit-147": "bash ./scripts/prepare_nodered_live_workspace.sh",
    "nodered:modular:build": "node scripts/nodered_modular_flow.mjs build",
    "nodered:modular:validate": "node scripts/nodered_modular_flow.mjs validate",
    "lint": "eslint .",
    "test:release-provenance": "node --test scripts/tests/releaseProvenance.test.mjs",
    "test:recovery-audits": "node --test scripts/tests/recoveryAuditTools.test.mjs",
    "test:tournament-category": "node --experimental-strip-types --test scripts/tests/tournamentCategory.test.ts",
    "test:mexicano-classic": "node --experimental-strip-types --test scripts/tests/mexicanoClassic.test.ts scripts/tests/mexicanoRecoveryIntegration.test.ts",
    "test:nodered-tournament-finished-at": "node --experimental-strip-types --test scripts/tests/tournamentFinishedAtIdempotency.nodered.test.ts",
    "test:nodered-tournament-history-limit": "node --experimental-strip-types --test scripts/tests/tournamentHistoryLimit.nodered.test.ts",
    "test:nodered-modular-toolchain": "node --test scripts/tests/noderedModularToolchain.test.mjs",
    "test:nodered-chat-recovery": "node --test scripts/tests/noderedChatRecovery.test.mjs",
    "test:games-list-identity-recovery": "node --test scripts/tests/gamesListIdentityRecovery.test.mjs",
    "test:games-direct-lookup-recovery": "node --test scripts/tests/gamesDirectLookupRecovery.test.mjs",
    "test:games-create-upsert-recovery": "node --test scripts/tests/gamesCreateUpsertRecovery.test.mjs",
    "test:games-patch-recovery": "node --test scripts/tests/gamesPatchRecovery.test.mjs",
    "test:split-payment-recovery": "node --test scripts/tests/splitPaymentRecovery.test.mjs",
    "test:tournament-prepare-recovery": "node --test scripts/tests/tournamentPrepareRecovery.test.mjs",
    "test:community-rating": "node --experimental-strip-types --test scripts/tests/communityRating.calculations.test.ts scripts/tests/communityRating.facts.test.ts scripts/tests/communityRating.aggregates.test.ts scripts/tests/communityRating.persistence.test.ts scripts/tests/communityRating.recalculation.test.ts scripts/tests/communityRating.noderedFlow.test.ts scripts/tests/trainingVisitsSync.test.ts",
    "test:deploy-topology": "node --experimental-strip-types --test scripts/tests/deployTopology.test.ts",
    "test:padel-day": "node --experimental-strip-types --test scripts/tests/padelDaySchedule.test.ts scripts/tests/padelDay.nodered.test.ts scripts/tests/padelDay.deploy.test.ts",
    "test:referral-subscription": "node --experimental-strip-types --test scripts/tests/referralSubscription.nodered.test.ts",
    "rating:recalculate": "node --experimental-strip-types scripts/recalculate_community_rating.mjs",
    "rating:recalculate:all": "node scripts/recalculate_community_rating_all.mjs",
    "rating:ledger:migrate": "node scripts/migrate_player_rating_ledger.mjs",
    "rating:state:migrate": "node --experimental-strip-types scripts/migrate_player_rating_state.mjs",
    "rating:worker": "node --experimental-strip-types scripts/rating_worker.mjs",
    "rating:reconcile": "node --experimental-strip-types scripts/reconcile_player_rating.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/ios": "^8.4.0",
    "@capacitor/push-notifications": "^8.1.1",
    "firebase": "^12.12.1",
    "mongodb": "^7.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.1.0",
    "@capacitor/cli": "^8.1.0",
    "@capacitor/core": "^8.1.0",
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "qrcode": "^1.5.4",
    "rollup-plugin-visualizer": "^5.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vite-plugin-css-injected-by-js": "^3.5.2"
  }
}
